import javax.swing.*;
import java.awt.*;
import java.awt.event.ActionEvent;
import java.awt.event.ActionListener;
import java.io.FileWriter;
import java.io.IOException;
import java.io.PrintWriter;

public class ProductApp extends JFrame {

    // GUI Components
    private JTextField txtCustomerName;
    private JComboBox<String> cmbProduct;
    private JTextField txtPrice;
    private JButton btnProcess;
    private JTextArea txtOutput;

    // Menu Components
    private JMenuBar menuBar;
    private JMenu fileMenu, editMenu;
    private JMenuItem exitItem, processItem, clearItem, saveItem;

    // Constants for Calculation Requirements
    private static final double VAT_RATE = 0.15;        // 15% VAT
    private static final double COMMISSION_RATE = 0.05; // 5% Commission

    public ProductApp() {
        // Frame Setup
        setTitle("Product App");
        setSize(420, 400);
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setLocationRelativeTo(null);
        setLayout(new BorderLayout(10, 10));

        // 1. Setup Menu Bar (File & Edit)
        setupMenuBar();

        // 2. Setup Input Panel
        JPanel inputPanel = new JPanel(new GridBagLayout());
        inputPanel.setBorder(BorderFactory.createEmptyBorder(15, 20, 10, 20));
        GridBagConstraints gbc = new GridBagConstraints();
        gbc.insets = new Insets(8, 8, 8, 8);
        gbc.fill = GridBagConstraints.HORIZONTAL;

        // Customer Name
        gbc.gridx = 0;
        gbc.gridy = 0;
        gbc.weightx = 0.3;
        inputPanel.add(new JLabel("Customer Name:"), gbc);

        gbc.gridx = 1;
        gbc.weightx = 0.7;
        txtCustomerName = new JTextField(15);
        inputPanel.add(txtCustomerName, gbc);

        // Select Product
        gbc.gridx = 0;
        gbc.gridy = 1;
        gbc.weightx = 0.3;
        inputPanel.add(new JLabel("Select Product:"), gbc);

        gbc.gridx = 1;
        gbc.weightx = 0.7;
        String[] products = {
            "Cozy Nights Monarch",
            "DreamCloud Luxury",
            "OrthoRest King",
            "Slumberpedic Queen"
        };
        cmbProduct = new JComboBox<>(products);
        inputPanel.add(cmbProduct, gbc);

        // Enter Price
        gbc.gridx = 0;
        gbc.gridy = 2;
        gbc.weightx = 0.3;
        inputPanel.add(new JLabel("Enter Price:"), gbc);

        gbc.gridx = 1;
        gbc.weightx = 0.7;
        txtPrice = new JTextField(15);
        inputPanel.add(txtPrice, gbc);

        // PROCESS Button
        gbc.gridx = 0;
        gbc.gridy = 3;
        gbc.gridwidth = 2;
        btnProcess = new JButton("PROCESS");
        inputPanel.add(btnProcess, gbc);

        add(inputPanel, BorderLayout.NORTH);

        // 3. Setup Output Display Area
        txtOutput = new JTextArea(8, 30);
        txtOutput.setEditable(false);
        txtOutput.setFont(new Font("Monospaced", Font.PLAIN, 12));
        JScrollPane scrollPane = new JScrollPane(txtOutput);
        scrollPane.setBorder(BorderFactory.createTitledBorder("Sales Details"));
        add(scrollPane, BorderLayout.CENTER);

        // 4. Register Event Listeners
        ActionListener processListener = e -> processSale();
        btnProcess.addActionListener(processListener);
        processItem.addActionListener(processListener);

        clearItem.addActionListener(e -> clearFields());
        exitItem.addActionListener(e -> System.exit(0));
        saveItem.addActionListener(e -> saveToFile());
    }

    private void setupMenuBar() {
        menuBar = new JMenuBar();

        // File Menu
        fileMenu = new JMenu("File");
        saveItem = new JMenuItem("Save Report");
        exitItem = new JMenuItem("Exit");
        fileMenu.add(saveItem);
        fileMenu.addSeparator();
        fileMenu.add(exitItem);

        // Edit Menu
        editMenu = new JMenu("Edit");
        processItem = new JMenuItem("Process");
        clearItem = new JMenuItem("Clear");
        editMenu.add(processItem);
        editMenu.add(clearItem);

        menuBar.add(fileMenu);
        menuBar.add(editMenu);
        setJMenuBar(menuBar);
    }

    private void processSale() {
        String customerName = txtCustomerName.getText().trim();
        String productName = (String) cmbProduct.getSelectedItem();
        String priceText = txtPrice.getText().trim();

        // Input Validation
        if (customerName.isEmpty() || priceText.isEmpty()) {
            JOptionPane.showMessageDialog(this,
                    "Please enter both Customer Name and Product Price.",
                    "Input Error",
                    JOptionPane.ERROR_MESSAGE);
            return;
        }

        try {
            double price = Double.parseDouble(priceText);
            if (price < 0) {
                JOptionPane.showMessageDialog(this,
                        "Price cannot be negative.",
                        "Input Error",
                        JOptionPane.ERROR_MESSAGE);
                return;
            }

            // Calculations
            double vatAmount = price * VAT_RATE;
            double commissionAmount = price * COMMISSION_RATE;
            double totalSaleAmount = price + vatAmount + commissionAmount;

            // Format Output
            String report = String.format(
                    "Customer Name:     %s\n" +
                    "Product Name:      %s\n" +
                    "Product Price:     R %.2f\n" +
                    "VAT Amount (15%%):  R %.2f\n" +
                    "Commission (5%%):   R %.2f\n" +
                    "------------------------------------\n" +
                    "Total Sale Amount: R %.2f\n",
                    customerName, productName, price, vatAmount, commissionAmount, totalSaleAmount
            );

            // Display in GUI
            txtOutput.setText(report);

            // Automatically store details to a text file
            saveDetailsToFile(report);

        } catch (NumberFormatException ex) {
            JOptionPane.showMessageDialog(this,
                    "Please enter a valid numeric value for Price.",
                    "Invalid Price",
                    JOptionPane.ERROR_MESSAGE);
        }
    }

    private void saveDetailsToFile(String report) {
        try (PrintWriter writer = new PrintWriter(new FileWriter("sales_report.txt", true))) {
            writer.println(report);
            writer.println("====================================");
        } catch (IOException ex) {
            JOptionPane.showMessageDialog(this,
                    "Error saving sale details to file: " + ex.getMessage(),
                    "File Error",
                    JOptionPane.ERROR_MESSAGE);
        }
    }

    private void saveToFile() {
        if (txtOutput.getText().isEmpty()) {
            JOptionPane.showMessageDialog(this, "No processed data to save.");
            return;
        }
        saveDetailsToFile(txtOutput.getText());
        JOptionPane.showMessageDialog(this, "Report saved to sales_report.txt");
    }

    private void clearFields() {
        txtCustomerName.setText("");
        cmbProduct.setSelectedIndex(0);
        txtPrice.setText("");
        txtOutput.setText("");
        txtCustomerName.requestFocus();
    }
private void.

    public static void main(String[] args) {
        SwingUtilities.invokeLater(() -> {
            new ProductApp().setVisible(true);
        });
    }
}
